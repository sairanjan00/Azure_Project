							"outputs": [
								{
									"referenceName": "DataSet_Sink_Onprem_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"p_file_name": {
											"value": "@replace(item().name, '.csv', '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Metadata - Array of Dictionaries",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "Metadata_Folder_Path_Dataset_SHIR",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "FileServerReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter Only CSV Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Metadata - Array of Dictionaries",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Metadata - Array of Dictionaries').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@endswith(item().name, '.csv')",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-04-07T18:59:39Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
